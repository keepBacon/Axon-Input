+    private void updateAndroidGamepadDevice(int deviceId, int logicalBit, int knownGroup, boolean pressed) {
+        int deviceButtons = valueAt(androidGamepadButtonsByDevice, deviceId);
+        int deviceKnown = valueAt(androidGamepadKnownByDevice, deviceId) | knownGroup;
+        if (pressed) deviceButtons |= logicalBit;
+        else deviceButtons &= ~logicalBit;
+        if (deviceButtons == 0) androidGamepadButtonsByDevice.remove(deviceId);
+        else androidGamepadButtonsByDevice.put(deviceId, deviceButtons);
+        androidGamepadKnownByDevice.put(deviceId, deviceKnown);
+        rebuildAndroidGamepadAggregate();
+    }
+
+    private int valueAt(android.util.SparseArray<Integer> values, int key) {
+        Integer value = values.get(key);
+        return value == null ? 0 : value;
+    }
+
+    private void rebuildAndroidGamepadAggregate() {
+        int buttons = 0;
+        int known = 0;
+        for (int i = 0; i < androidGamepadButtonsByDevice.size(); i++) {
+            Integer value = androidGamepadButtonsByDevice.valueAt(i);
+            if (value != null) buttons |= value;
+        }
+        for (int i = 0; i < androidGamepadKnownByDevice.size(); i++) {
+            Integer value = androidGamepadKnownByDevice.valueAt(i);
+            if (value != null) known |= value;
+        }
+        androidGamepadButtons = buttons;
+        androidGamepadKnownMask = known;
+    }
+
+    private boolean releaseAndroidGamepadDevice(int deviceId) {
+        boolean changed = androidGamepadButtonsByDevice.get(deviceId) != null
+                || androidGamepadKnownByDevice.get(deviceId) != null;
+        if (!changed) return false;
+        androidGamepadButtonsByDevice.remove(deviceId);
+        androidGamepadKnownByDevice.remove(deviceId);
+        rebuildAndroidGamepadAggregate();
+        return true;
+    }
+
+    private void clearAndroidGamepadMirrorBits(int bits) {
+        if (bits == 0) return;
+        for (int i = androidGamepadButtonsByDevice.size() - 1; i >= 0; i--) {
+            int next = valueAt(androidGamepadButtonsByDevice, androidGamepadButtonsByDevice.keyAt(i)) & ~bits;
+            if (next == 0) androidGamepadButtonsByDevice.removeAt(i);
+            else androidGamepadButtonsByDevice.setValueAt(i, next);
+        }
+        for (int i = androidGamepadKnownByDevice.size() - 1; i >= 0; i--) {
+            int next = valueAt(androidGamepadKnownByDevice, androidGamepadKnownByDevice.keyAt(i)) & ~bits;
+            if (next == 0) androidGamepadKnownByDevice.removeAt(i);
+            else androidGamepadKnownByDevice.setValueAt(i, next);
+        }
+        rebuildAndroidGamepadAggregate();
+    }
