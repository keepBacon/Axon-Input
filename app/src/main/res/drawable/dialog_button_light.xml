<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D6E8F4FF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#BCE0E8F0" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#0A84FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#94D9D9D9" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#A8FFFFFF" />
        </shape>
    </item>
</selector>
